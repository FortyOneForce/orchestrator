<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<PackageId>FortyOne.OrchestratR.Abstractions</PackageId>
		<AssemblyName>FortyOne.OrchestratR.Abstractions</AssemblyName>
		<RootNamespace>FortyOne.OrchestratR</RootNamespace>
		<Description>Core abstractions for the OrchestratR library, a lightweight .NET mediator implementation supporting CQRS and event-driven patterns. Defines the foundational interfaces for request/response processing, notification dispatching, and pipeline interception. Includes contracts for command and query handlers, notification subscribers, and middleware components. Designed for modern .NET applications targeting .NET 8 and .NET 9 with minimal dependencies.</Description>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
	</ItemGroup>
</Project>
